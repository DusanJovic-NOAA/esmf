#!/bin/bash
set -eu

cd @ESMF_DIR@/src

echo "#################################################################################"
echo "#################################################################################"
echo "##                                                                             ##"
echo "##    System test                                                              ##"
echo "##                                                                             ##"
echo "#################################################################################"
echo "#################################################################################"
@ESMF_DIR@/scripts/test_scripts/do_st_results.pl -h @ESMF_DIR@/scripts/test_scripts -d @TESTS_RUNDIR@ -b @ESMF_BOPT@ -e @ESMF_COMM@

echo "#################################################################################"
echo "#################################################################################"
echo "##                                                                             ##"
echo "##    Unit tests                                                               ##"
echo "##                                                                             ##"
echo "#################################################################################"
echo "#################################################################################"
@ESMF_DIR@/scripts/test_scripts/do_ut_results.pl -h @ESMF_DIR@/scripts/test_scripts -d @TESTS_RUNDIR@ -b @ESMF_BOPT@ -e @ESMF_COMM@

echo "#################################################################################"
echo "#################################################################################"
echo "##                                                                             ##"
echo "##    Examples                                                                 ##"
echo "##                                                                             ##"
echo "#################################################################################"
echo "#################################################################################"
@ESMF_DIR@/scripts/test_scripts/do_ex_results.pl -h @ESMF_DIR@/scripts/test_scripts -d @TESTS_RUNDIR@ -b @ESMF_BOPT@ -e @ESMF_COMM@
